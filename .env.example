# MongoDB Connection String
# Local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/books-db

# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/books-db?retryWrites=true&w=majority

# MongoDB with authentication (Local)
# MONGODB_URI=mongodb://username:password@localhost:27017/books-db?authSource=admin